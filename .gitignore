/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Mac has the tendency of storing a DS_Store
.DS_Store

# Add results and figures to the .gitignore
scripts/results/niels
scripts/figures
inst/doc
*depr*

# Some other stuff that is not useful to have on the github
scripts/data/*.R 
scripts/data/RUTLEDGE*/
*.zip
*.pdf
scripts/data/*participant*/

